# Google Gemini API (for Query Understanding, XAI, Follow-up, Response)
GEMINI_API_KEY=your_gemini_api_key_here

# Cloud PostgreSQL Database
# Example: postgresql+psycopg://username:password@ep-cool-host.region.aws.neon.tech/smartpick?sslmode=require
DATABASE_URL=postgresql+psycopg://user:password@host:5432/smartpick?sslmode=require

# Authentication & JWT Configuration
JWT_SECRET_KEY=change_this_to_a_secure_random_secret_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Brevo Transactional Email Service
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=noreply@smartpick.ai
BREVO_SENDER_NAME=SmartPick

# OTP Security Policy
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
